{
  "name": "vibeguard",
  "displayName": "VibeGuard",
  "description": "Know what Claude Code is about to do, before you approve it. Plain-English safety ratings in a real popup. By Rockfort AI.",
  "version": "1.0.0",
  "publisher": "rockfort-ai",
  "license": "MIT",
  "icon": "icon.png",
  "galleryBanner": {
    "color": "#0A1B36",
    "theme": "dark"
  },
  "author": {
    "name": "Rockfort AI",
    "url": "https://rockfort.ai"
  },
  "homepage": "https://github.com/rockfort-ai/vibeguard",
  "bugs": {
    "url": "https://github.com/rockfort-ai/vibeguard/issues"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Other"],
  "keywords": ["claude", "claude code", "security", "permissions", "safety"],
  "main": "./src/extension.js",
  "activationEvents": ["onStartupFinished"],
  "contributes": {
    "commands": [
      {
        "command": "vibeguard.showPanel",
        "title": "VibeGuard: Show recent activity"
      },
      {
        "command": "vibeguard.clearHistory",
        "title": "VibeGuard: Clear history"
      },
      {
        "command": "vibeguard.status",
        "title": "VibeGuard: Check connection to Claude Code"
      }
    ],
    "configuration": {
      "title": "VibeGuard",
      "properties": {
        "vibeguard.popupOn": {
          "type": "string",
          "enum": ["red", "orangeAndRed", "all", "off"],
          "enumDescriptions": [
            "Only high-risk actions",
            "High-risk and check-first actions",
            "Every action Claude asks permission for",
            "Never pop up; the panel and status bar still update"
          ],
          "default": "orangeAndRed",
          "description": "Which risk levels raise a popup."
        },
        "vibeguard.revealPanelOn": {
          "type": "string",
          "enum": ["red", "orangeAndRed", "all", "never"],
          "default": "red",
          "description": "Which risk levels automatically open the VibeGuard panel."
        },
        "vibeguard.statusBar": {
          "type": "boolean",
          "default": true,
          "description": "Show the VibeGuard indicator in the status bar."
        }
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/rockfort-ai/vibeguard.git"
  },
  "scripts": {
    "package": "npx --yes @vscode/vsce package --no-dependencies"
  }
}
